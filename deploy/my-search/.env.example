# Copy to .env and edit. Never commit .env.

# Image tag: "latest" or a pinned one like "2026.10.19-8137186".
SEARXNG_VERSION=latest

# REQUIRED. Generate: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME

# Public URL of the instance (used for absolute links, RSS, OpenSearch).
SEARXNG_BASE_URL=http://127.0.0.1:8080/
# With the tls profile: SEARXNG_BASE_URL=https://search.example.com/

# Local bind for the plain-HTTP port (keep 127.0.0.1 when Caddy is in front).
SEARXNG_BIND=127.0.0.1
SEARXNG_PORT=8080

# Bot protection (needs Valkey, configured in searxng/limiter.toml).
SEARXNG_LIMITER=true

# Set to true only if anyone on the internet may use the instance.
SEARXNG_PUBLIC_INSTANCE=false

# --- Caddy (profile "tls") --------------------------------------------------
DOMAIN=search.example.com
ACME_EMAIL=you@example.com
